{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "git": { "deploymentEnabled": true },
  "buildCommand": "node build-vercel.cjs",
  "outputDirectory": ".vercel-static",
  "regions": ["fra1"],
  "functions": {
    "api/gateway.js": { "maxDuration": 30 }
  },
  "rewrites": [
    { "source": "/api/:resource(session|register|login|logout|plans|garmin|social|foods)", "destination": "/api/gateway?__fitness_route=/api/:resource" },
    { "source": "/api/plans/:id", "destination": "/api/gateway?__fitness_route=/api/plans/:id" },
    { "source": "/auth/confirm", "destination": "/api/gateway?__fitness_route=/auth/confirm" }
  ]
}
